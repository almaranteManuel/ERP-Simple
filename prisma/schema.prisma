generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Product {
  id          Int         @id @default(autoincrement())
  code        String
  description String?
  price       Decimal?
  own_price   String?
  variant     Decimal     @default(1.70)
  category_id Int?
  stock       Int?
  created_at  String?
  updated_at  String?
  categories  categories? @relation(fields: [category_id], references: [id], onDelete: Cascade)

  @@map("products")
}

model Supplier {
  id         Int     @id @default(autoincrement())
  name       String
  email      String?
  phone      String?
  address    String?
  created_at String?
  updated_at String?

  @@map("suppliers")
}

model Purchase {
  id          Int      @id @default(autoincrement())
  date        DateTime
  totalAmount Decimal
  created_at  String?
  updated_at  String?
  supplier_id Int?

  @@map("purchases")
}

model Sale {
  id          Int      @id @default(autoincrement())
  date        DateTime
  totalAmount Decimal
  created_at  String?
  updated_at  String?

  @@map("sales")
}

model Reminder {
  id          Int                        @id @default(autoincrement())
  description String?
  completed   Unsupported("tinyint(1)")? @default(dbgenerated("0"))

  @@map("reminders")
}

model categories {
  id         Int       @id @default(autoincrement())
  name       String
  created_at String?
  updated_at String?
  products   Product[]
}
